{
    "files.exclude": {
        "**/.hemttout": true,
        "**/include": false,
        "**/extras": true
    },
    "files.insertFinalNewline": true,

    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "sqf.sqf.enableCBA": true,
    "sqf.sqf.enableACE3": true,

    "[sqf]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.trimAutoWhitespace": true,
        "editor.autoClosingBrackets": "beforeWhitespace",
        "editor.defaultFormatter": "th3-sh0w3r.sqf-arma3-formatter",
        
    }
}
